{
  "manifest_version": 3,
  "name": "You Are Not Reconnected",
  "version": "1.2.0",
  "description": "Loses your internet, then refuses to admit it's back until you beat Minesweeper.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["game/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
